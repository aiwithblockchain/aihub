{
  "manifest_version": 3,
  "name": "TweetClaw",
  "version": "0.9.38",
  "description": "Bridges X (Twitter), Xiaohongshu, and Instagram sessions to local apps via WebSocket. Requires local server for full functionality.",
  "background": {
    "service_worker": "js/background.js"
  },
  "icons": {
    "16": "images/logo_16.png",
    "48": "images/logo_48.png",
    "128": "images/logo_128.png"
  },
  "action": {
    "default_icon": {
      "16": "images/logo_16.png",
      "48": "images/logo_48.png",
      "128": "images/logo_128.png"
    },
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
      ],
      "js": [
        "js/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.xiaohongshu.com/*",
        "https://xiaohongshu.com/*",
        "https://*.xiaohongshu.com/*",
        "https://creator.xiaohongshu.com/*"
      ],
      "js": [
        "js/content-xhs.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": [
        "js/content-ig.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "alarms",
    "cookies"
  ],
  "host_permissions": [
    "*://twitter.com/*",
    "*://x.com/*",
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "https://www.xiaohongshu.com/*",
    "https://xiaohongshu.com/*",
    "https://*.xiaohongshu.com/*",
    "https://edith.xiaohongshu.com/*",
    "https://www.instagram.com/*",
    "https://instagram.com/*",
    "https://i.instagram.com/*",
    "http://127.0.0.1:8765/*",
    "ws://127.0.0.1:8765/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "js/injection.js"
      ],
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*",
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ]
    },
    {
      "resources": [
        "js/xhs-sign-inject.js",
        "js/xhs-rap-bundle.js"
      ],
      "matches": [
        "https://www.xiaohongshu.com/*",
        "https://xiaohongshu.com/*",
        "https://*.xiaohongshu.com/*"
      ]
    }
  ]
}
